# Copy to .env and fill in. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# --- LLM ---
# Optional. Without a key, retrieval works and /ask returns a clear configuration error.
# Google Gemini (default), called through its OpenAI-compatible endpoint.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Alternative: an OpenAI (or other OpenAI-compatible) key. Ignored when GEMINI_API_KEY is set.
OPENAI_API_KEY=
# Leave both empty to use the provider defaults:
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai + gemini-2.5-flash
#   OpenAI: https://api.openai.com/v1 + gpt-4o-mini
# The model name is not validated; set one your key can actually use.
LLM_BASE_URL=
LLM_MODEL=

# --- Local CPU models (downloaded from Hugging Face on first use) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Storage ---
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=pubmed_abstracts

# --- PubMed E-utilities (email recommended by NCBI; API key optional) ---
PUBMED_EMAIL=
PUBMED_API_KEY=

# --- Retrieval ---
TOP_K_BM25=20
TOP_K_DENSE=20
TOP_K_FUSION=15
TOP_K_RERANK=5
RRF_K=60

# --- Abstention heuristics (NOT calibrated probabilities; tune on a validation split) ---
# Raw cross-encoder logit threshold for "sufficiently relevant".
MIN_RERANK_SCORE=0.0
MIN_EVIDENCE_COUNT=2
ENABLE_CLAIM_CHECK=true
MIN_CLAIM_SUPPORT_RATE=0.8
MIN_CITATION_COVERAGE=0.8

MAX_ABSTRACT_CHARS=4000
REQUEST_TIMEOUT_SECONDS=30

# Set to enable POST /ingest (send it as the X-Admin-Token header). Empty = endpoint disabled.
ADMIN_TOKEN=
